<% layout('/layouts/boilerplate') -%>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 ">
    <% for(let list of allListings){ %>
      <a href="/listings/<%= list._id %>" class="listing-link">
      <div class="card listing-card h-100 mt-3">
         <img src="<%= list.image.url %>" class="card-img-top listing-img" alt="listing-image">
          <div class="card-img-overlay">abcd</div>
          <div class="card-body">
            <h5 class="card-title">
              <%= list.title %>
            </h5>
            <p class="card-text"> &#8377; <%= list.price ? list.price.toLocaleString("en-IN") : "0" %> / night
            </p>

          </div>
        </div>
      </a>
      <% } %>
  </div>